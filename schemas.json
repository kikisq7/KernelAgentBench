{
  "candidate": {
    "$defs": {
      "EvaluationConfig": {
        "additionalProperties": false,
        "properties": {
          "atol": {
            "minimum": 0,
            "title": "Atol",
            "type": "number"
          },
          "correctness_shapes": {
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            "title": "Correctness Shapes",
            "type": "array"
          },
          "dtype": {
            "default": "Float32",
            "title": "Dtype",
            "type": "string"
          },
          "max_regression_fraction": {
            "exclusiveMaximum": 1,
            "minimum": 0,
            "title": "Max Regression Fraction",
            "type": "number"
          },
          "min_relative_improvement": {
            "exclusiveMaximum": 1,
            "minimum": 0,
            "title": "Min Relative Improvement",
            "type": "number"
          },
          "performance_shapes": {
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            "title": "Performance Shapes",
            "type": "array"
          },
          "repetitions": {
            "minimum": 1,
            "title": "Repetitions",
            "type": "integer"
          },
          "rtol": {
            "minimum": 0,
            "title": "Rtol",
            "type": "number"
          },
          "steps": {
            "minimum": 1,
            "title": "Steps",
            "type": "integer"
          },
          "warmups": {
            "minimum": 0,
            "title": "Warmups",
            "type": "integer"
          }
        },
        "required": [
          "correctness_shapes",
          "performance_shapes",
          "steps",
          "warmups",
          "repetitions",
          "atol",
          "rtol",
          "max_regression_fraction",
          "min_relative_improvement"
        ],
        "title": "EvaluationConfig",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "baseline_commit": {
        "title": "Baseline Commit",
        "type": "string"
      },
      "candidate_id": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,199}$",
        "title": "Candidate Id",
        "type": "string"
      },
      "created_at": {
        "format": "date-time",
        "title": "Created At",
        "type": "string"
      },
      "evaluation": {
        "$ref": "#/$defs/EvaluationConfig"
      },
      "iteration": {
        "title": "Iteration",
        "type": "integer"
      },
      "language": {
        "title": "Language",
        "type": "string"
      },
      "parent_candidate_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Parent Candidate Id"
      },
      "patch_file": {
        "title": "Patch File",
        "type": "string"
      },
      "patch_sha256": {
        "title": "Patch Sha256",
        "type": "string"
      },
      "prompt_sha256": {
        "title": "Prompt Sha256",
        "type": "string"
      },
      "schema_version": {
        "default": "2.0",
        "title": "Schema Version",
        "type": "string"
      },
      "study_hash": {
        "title": "Study Hash",
        "type": "string"
      },
      "task_version": {
        "title": "Task Version",
        "type": "string"
      },
      "trial_id": {
        "title": "Trial Id",
        "type": "string"
      }
    },
    "required": [
      "candidate_id",
      "trial_id",
      "baseline_commit",
      "patch_sha256",
      "patch_file",
      "iteration",
      "language",
      "task_version",
      "study_hash",
      "prompt_sha256",
      "evaluation"
    ],
    "title": "CandidateManifest",
    "type": "object"
  },
  "evaluation": {
    "$defs": {
      "WorkloadResult": {
        "additionalProperties": false,
        "properties": {
          "baseline_median_ms": {
            "title": "Baseline Median Ms",
            "type": "number"
          },
          "baseline_samples_ms": {
            "items": {
              "type": "number"
            },
            "title": "Baseline Samples Ms",
            "type": "array"
          },
          "baseline_std_ms": {
            "default": 0,
            "title": "Baseline Std Ms",
            "type": "number"
          },
          "candidate_median_ms": {
            "title": "Candidate Median Ms",
            "type": "number"
          },
          "candidate_samples_ms": {
            "items": {
              "type": "number"
            },
            "title": "Candidate Samples Ms",
            "type": "array"
          },
          "candidate_std_ms": {
            "default": 0,
            "title": "Candidate Std Ms",
            "type": "number"
          },
          "correct": {
            "title": "Correct",
            "type": "boolean"
          },
          "max_abs_error": {
            "title": "Max Abs Error",
            "type": "number"
          },
          "relative_l2_error": {
            "title": "Relative L2 Error",
            "type": "number"
          },
          "shape": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer"
              }
            ],
            "title": "Shape",
            "type": "array"
          },
          "speedup": {
            "title": "Speedup",
            "type": "number"
          }
        },
        "required": [
          "shape",
          "baseline_samples_ms",
          "candidate_samples_ms",
          "baseline_median_ms",
          "candidate_median_ms",
          "speedup",
          "correct",
          "max_abs_error",
          "relative_l2_error"
        ],
        "title": "WorkloadResult",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "candidate_id": {
        "title": "Candidate Id",
        "type": "string"
      },
      "compile_seconds": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Compile Seconds"
      },
      "correct": {
        "title": "Correct",
        "type": "boolean"
      },
      "correctness_cases": {
        "items": {
          "additionalProperties": true,
          "type": "object"
        },
        "title": "Correctness Cases",
        "type": "array"
      },
      "created_at": {
        "format": "date-time",
        "title": "Created At",
        "type": "string"
      },
      "end_to_end_seconds": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "End To End Seconds"
      },
      "environment": {
        "additionalProperties": true,
        "title": "Environment",
        "type": "object"
      },
      "error": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Error"
      },
      "evaluator_version": {
        "title": "Evaluator Version",
        "type": "string"
      },
      "geometric_mean_speedup": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Geometric Mean Speedup"
      },
      "language": {
        "title": "Language",
        "type": "string"
      },
      "result_sha256": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Result Sha256"
      },
      "schema_version": {
        "default": "2.0",
        "title": "Schema Version",
        "type": "string"
      },
      "status": {
        "title": "Status",
        "type": "string"
      },
      "workloads": {
        "items": {
          "$ref": "#/$defs/WorkloadResult"
        },
        "title": "Workloads",
        "type": "array"
      }
    },
    "required": [
      "candidate_id",
      "language",
      "evaluator_version",
      "status",
      "correct"
    ],
    "title": "EvaluationResult",
    "type": "object"
  },
  "study": {
    "$defs": {
      "Budgets": {
        "additionalProperties": false,
        "properties": {
          "max_agent_iterations": {
            "maximum": 5,
            "minimum": 1,
            "title": "Max Agent Iterations",
            "type": "integer"
          },
          "max_h200_evaluations": {
            "maximum": 5,
            "minimum": 1,
            "title": "Max H200 Evaluations",
            "type": "integer"
          },
          "max_total_tokens": {
            "minimum": 1,
            "title": "Max Total Tokens",
            "type": "integer"
          },
          "max_wall_seconds": {
            "minimum": 1,
            "title": "Max Wall Seconds",
            "type": "integer"
          }
        },
        "required": [
          "max_agent_iterations",
          "max_h200_evaluations",
          "max_total_tokens",
          "max_wall_seconds"
        ],
        "title": "Budgets",
        "type": "object"
      },
      "EvaluationConfig": {
        "additionalProperties": false,
        "properties": {
          "atol": {
            "minimum": 0,
            "title": "Atol",
            "type": "number"
          },
          "correctness_shapes": {
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            "title": "Correctness Shapes",
            "type": "array"
          },
          "dtype": {
            "default": "Float32",
            "title": "Dtype",
            "type": "string"
          },
          "max_regression_fraction": {
            "exclusiveMaximum": 1,
            "minimum": 0,
            "title": "Max Regression Fraction",
            "type": "number"
          },
          "min_relative_improvement": {
            "exclusiveMaximum": 1,
            "minimum": 0,
            "title": "Min Relative Improvement",
            "type": "number"
          },
          "performance_shapes": {
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            "title": "Performance Shapes",
            "type": "array"
          },
          "repetitions": {
            "minimum": 1,
            "title": "Repetitions",
            "type": "integer"
          },
          "rtol": {
            "minimum": 0,
            "title": "Rtol",
            "type": "number"
          },
          "steps": {
            "minimum": 1,
            "title": "Steps",
            "type": "integer"
          },
          "warmups": {
            "minimum": 0,
            "title": "Warmups",
            "type": "integer"
          }
        },
        "required": [
          "correctness_shapes",
          "performance_shapes",
          "steps",
          "warmups",
          "repetitions",
          "atol",
          "rtol",
          "max_regression_fraction",
          "min_relative_improvement"
        ],
        "title": "EvaluationConfig",
        "type": "object"
      },
      "LanguageTarget": {
        "additionalProperties": false,
        "properties": {
          "editable_paths": {
            "items": {
              "type": "string"
            },
            "title": "Editable Paths",
            "type": "array"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "prompt_path": {
            "title": "Prompt Path",
            "type": "string"
          },
          "public_test_command": {
            "title": "Public Test Command",
            "type": "string"
          }
        },
        "required": [
          "id",
          "editable_paths",
          "public_test_command",
          "prompt_path"
        ],
        "title": "LanguageTarget",
        "type": "object"
      },
      "ModelSelector": {
        "additionalProperties": false,
        "properties": {
          "alias": {
            "title": "Alias",
            "type": "string"
          },
          "match": {
            "title": "Match",
            "type": "string"
          },
          "newest": {
            "default": true,
            "title": "Newest",
            "type": "boolean"
          }
        },
        "required": [
          "alias",
          "match"
        ],
        "title": "ModelSelector",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "budgets": {
        "$ref": "#/$defs/Budgets"
      },
      "evaluation": {
        "$ref": "#/$defs/EvaluationConfig"
      },
      "languages": {
        "items": {
          "$ref": "#/$defs/LanguageTarget"
        },
        "title": "Languages",
        "type": "array"
      },
      "models": {
        "items": {
          "$ref": "#/$defs/ModelSelector"
        },
        "title": "Models",
        "type": "array"
      },
      "replicates": {
        "minimum": 1,
        "title": "Replicates",
        "type": "integer"
      },
      "seed": {
        "title": "Seed",
        "type": "integer"
      },
      "study_id": {
        "title": "Study Id",
        "type": "string"
      },
      "task_version": {
        "title": "Task Version",
        "type": "string"
      },
      "trace_content": {
        "default": true,
        "title": "Trace Content",
        "type": "boolean"
      }
