    "required": [
      "study_id",
      "task_version",
      "seed",
      "replicates",
      "models",
      "languages",
      "budgets",
      "evaluation"
    ],
    "title": "StudyConfig",
    "type": "object"
  },
  "trial": {
    "$defs": {
      "TokenRecord": {
        "additionalProperties": false,
        "properties": {
          "available": {
            "default": true,
            "title": "Available",
            "type": "boolean"
          },
          "cache_read_tokens": {
            "default": 0,
            "title": "Cache Read Tokens",
            "type": "integer"
          },
          "cache_write_tokens": {
            "default": 0,
            "title": "Cache Write Tokens",
            "type": "integer"
          },
          "input_tokens": {
            "default": 0,
            "title": "Input Tokens",
            "type": "integer"
          },
          "output_tokens": {
            "default": 0,
            "title": "Output Tokens",
            "type": "integer"
          },
          "reasoning_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Reasoning Tokens"
          },
          "total_tokens": {
            "default": 0,
            "title": "Total Tokens",
            "type": "integer"
          }
        },
        "title": "TokenRecord",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "h200_evaluations": {
        "title": "H200 Evaluations",
        "type": "integer"
      },
      "incumbent_candidate_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Incumbent Candidate Id"
      },
      "incumbent_speedup": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Incumbent Speedup"
      },
      "iteration": {
        "title": "Iteration",
        "type": "integer"
      },
      "language": {
        "title": "Language",
        "type": "string"
      },
      "metadata": {
        "additionalProperties": true,
        "title": "Metadata",
        "type": "object"
      },
      "model_alias": {
        "title": "Model Alias",
        "type": "string"
      },
      "replicate": {
        "title": "Replicate",
        "type": "integer"
      },
      "resolved_model_id": {
        "title": "Resolved Model Id",
        "type": "string"
      },
      "schema_version": {
        "default": "2.0",
        "title": "Schema Version",
        "type": "string"
      },
      "status": {
        "title": "Status",
        "type": "string"
      },
      "study_id": {
        "title": "Study Id",
        "type": "string"
      },
      "termination_reason": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Termination Reason"
      },
      "token_usage": {
        "$ref": "#/$defs/TokenRecord"
      },
      "trial_id": {
        "title": "Trial Id",
        "type": "string"
      }
    },
    "required": [
      "study_id",
      "trial_id",
      "model_alias",
      "resolved_model_id",
      "language",
      "replicate",
      "status",
      "iteration",
      "h200_evaluations",
      "token_usage"
    ],
    "title": "TrialRecord",
    "type": "object"
  }
}
