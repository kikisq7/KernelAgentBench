# Required by Cursor SDK model runs.
CURSOR_API_KEY=

# Required to upload LangSmith traces.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=kernel-agent-bench
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Set false if prompts and source excerpts must not leave the machine.
KAB_TRACE_CONTENT=true
