# Copy to .env only once:  cp .env.example .env
# Never overwrite an existing .env — that erases your keys.
# Required by Cursor SDK model runs (Composer, Kimi). Not used for Claude or GPT.
CURSOR_API_KEY=

# Claude Opus trials call the Anthropic API directly. This is not a Cursor key.
# Create one at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# GPT trials call the OpenAI API directly through the Codex CLI. Not a Cursor key.
# Create one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional LangSmith traces. Leave tracing false unless you have a key.
# Get a key at https://smith.langchain.com — this is not a Cursor key.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=kernel-agent-bench
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Set false if prompts and source excerpts must not leave the machine.
KAB_TRACE_CONTENT=true
